# Build for the AWS origin behind the accounts gateway (npm run build:accounts).
# The site, /auth/* and every API share one origin, so the URLs are paths.
VITE_ACCOUNTS=on
VITE_DATA_QUERY_URL=/api/data-query
VITE_VISUALIZATION_URL=/api/visualization
VITE_RISK_URL=/api/risk-forecasting
VITE_AGENT_URL=/api/agent
