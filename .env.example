# Postgres / PostGIS (Docker Compose + loaders)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=wildfire
POSTGRES_USER=wildfire
POSTGRES_PASSWORD=wildfire

# Optional full DSN override (takes precedence over POSTGRES_* if set)
# DATABASE_URL=postgresql://wildfire:wildfire@localhost:5433/wildfire

# Read-only source data (sibling dataset_demo repo)
DATASET_DEMO_DATA_DIR=../dataset_demo/assets/data

# Risk-service paths. Read from this file or the process environment (the
# process wins); relative paths resolve from the repo root. Defaults shown.
# RISK_FORECASTING_ROOT=services/risk_forecasting
# RISK_FORECASTING_DATA_DIR=services/risk_forecasting/data
# RISK_FORECASTING_ARTIFACTS_DIR=services/risk_forecasting/artifacts

# Grid cell size in degrees (must match risk model / weather_anim meta)
GRID_CELL_SPACING_DEG=0.24

# Read-only agent (port 8004). Routing and synthesis run on OpenRouter
# (GPT-6 Luna, GPT-6 Sol on retries). OPENROUTER_API_KEY is required, and the
# service refuses to start until AGENT_ALLOW_REMOTE_PROVIDER=true confirms
# that questions may leave the host. See docs/OPENROUTER.md.
# OPENROUTER_API_KEY=
AGENT_ALLOW_REMOTE_PROVIDER=false
AGENT_LLM_PROVIDER=openrouter
# AGENT_LLM_MODEL=openai/gpt-6-luna
# AGENT_LLM_FALLBACK_MODEL=openai/gpt-6-sol
# Synthesis reasoning effort (medium when true, none when false).
AGENT_SYNTHESIS_THINKING=false
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_TOOL_STEPS=5
AGENT_MAX_VALIDATION_RETRIES=2
DATA_QUERY_BASE_URL=http://127.0.0.1:8000
RISK_FORECASTING_BASE_URL=http://127.0.0.1:8001
VISUALIZATION_BASE_URL=http://127.0.0.1:8002
COMPARISON_BASE_URL=http://127.0.0.1:8003
# Jev (TypeSafe). Default off never imports the SDK and never calls the API.
# Any other mode sends question text to a remote backend, so startup requires
# AGENT_ALLOW_REMOTE_PROVIDER=true and the active backend's key (TYPESAFE_API_KEY
# for typesafe, OPENROUTER_API_KEY for openrouter), and refuses to start otherwise.
# Put TYPESAFE_API_KEY in the host environment or systemd EnvironmentFile, never in git.
AGENT_JEV_MODE=off
# tool_pick: Jev chooses the model-path tool. The LLM still writes the answer.
# tool_pick_template: same tool choice, then a template when the intent is a simple read.
# AGENT_JEV_TOOL_PICK_MIN_CONFIDENCE=0.8
# decide: router backstops first, then Jev's disposition behind a gate. See docs/JEV_DECIDE.md.
# AGENT_JEV_DECIDE_MIN_CONFIDENCE=0.8
# AGENT_JEV_DECIDE_ANSWER_CONFIDENCE=0.9
# typesafe (default) or openrouter. openrouter uses the same OPENROUTER_API_KEY
# and defaults AGENT_JEV_MODEL to typesafe/jev-1.13-20260917 when AGENT_JEV_MODEL is unset.
AGENT_JEV_BACKEND=typesafe
AGENT_JEV_MODEL=jev-latest
AGENT_JEV_TIMEOUT_SECONDS=3
AGENT_JEV_SAMPLE_RATE=1.0
AGENT_JEV_MAX_CONCURRENCY=4
# Counts Jev API calls per process per UTC day, not questions. One question makes
# three calls in decide mode (v3_hybrid) and up to four in shadow mode (plus a tool
# pick on the model path). A question whose calls do not all fit sends none of them:
# decide mode falls back to the router (decision_source why jev_daily_cap) and
# shadow mode logs it as dropped with reason daily_cap.
AGENT_JEV_DAILY_CALL_CAP=5000
# Winning ablation config.
AGENT_JEV_ABLATION=v3_hybrid
# Every write takes a lock on <path>.lock, so several uvicorn workers may share one log.
AGENT_JEV_LOG_PATH=services/agent/logs/jev_shadow.jsonl
AGENT_JEV_LOG_MAX_MB=50
# TYPESAFE_API_KEY=
