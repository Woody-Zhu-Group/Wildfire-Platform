# Postgres / PostGIS (Docker Compose + loaders)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=wildfire
POSTGRES_USER=wildfire
POSTGRES_PASSWORD=wildfire

# Optional full DSN override (takes precedence over POSTGRES_* if set)
# DATABASE_URL=postgresql://wildfire:wildfire@localhost:5433/wildfire

# Read-only source data (sibling dataset_demo repo)
DATASET_DEMO_DATA_DIR=../dataset_demo/assets/data

# Risk-service grid (824 cells) — defaults to services/risk_forecasting/data if unset
# RISK_FORECASTING_DATA_DIR=services/risk_forecasting/data

# Grid cell size in degrees (must match risk model / weather_anim meta)
GRID_CELL_SPACING_DEG=0.24

# Local read-only agent prototype (port 8004)
AGENT_PROVIDER=openai_compatible
AGENT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
AGENT_MODEL_API_KEY=ollama
AGENT_MODEL=qwen2.5:7b
AGENT_THINKING=off
AGENT_STRUCTURED_MODE=constrained
# Synthesis thinking is supported (uses base qwen3, not the no-think alias) but
# on CPU-only hardware it exceeded the 180s synthesis timeout in probes; keep
# false locally unless you raise AGENT_SYNTHESIS_TIMEOUT_SECONDS.
AGENT_SYNTHESIS_THINKING=false
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_TOOL_STEPS=5
AGENT_MAX_VALIDATION_RETRIES=2
DATA_QUERY_BASE_URL=http://127.0.0.1:8000
RISK_FORECASTING_BASE_URL=http://127.0.0.1:8001
VISUALIZATION_BASE_URL=http://127.0.0.1:8002
COMPARISON_BASE_URL=http://127.0.0.1:8003

# Optional legacy GPU control (port 8005). With the three resource values
# below unset, status reports disabled and start/stop return 503. Do not commit
# real infrastructure identifiers or tokens.
# GPU_INSTANCE_ID=
# GPU_AWS_REGION=
# GPU_OLLAMA_URL=
# GPU_MODEL=
# GPU_AGENT_URL=http://127.0.0.1:8004
# GPU_CONTROL_TOKEN=
