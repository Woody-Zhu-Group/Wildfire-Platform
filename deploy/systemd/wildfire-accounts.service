[Unit]
Description=Wildfire accounts API (loopback port 8005)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Wildfire-Services
EnvironmentFile=/home/ubuntu/Wildfire-Services/.env
Environment=PYTHONPATH=/home/ubuntu/Wildfire-Services
Environment=PYTHONIOENCODING=utf-8
ExecStart=/home/ubuntu/Wildfire-Services/.venv/bin/uvicorn services.accounts.app:app --host 127.0.0.1 --port 8005 --app-dir . --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
